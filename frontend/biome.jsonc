{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!src/client",
      "!!src/routeTree.gen.ts",
      // generated by `shadcn add`, kept as generated so it can be re-added; its texts go through
      // i18next by hand (locales `ui.*`)
      "!!src/components/ui",
      "!!src/hooks/use-mobile.ts"
    ]
  },
  "css": { "parser": { "tailwindDirectives": true } }, // @apply, @theme, @custom-variant
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      // Every rule, minus those written for other frameworks or out of scope for this app.
      // `noJsxLiterals` stays on: every text the UI shows comes from the locale files.
      "preset": "all",
      "correctness": {
        "noUnresolvedImports": "off", // tsc resolves imports; false positives on @types/react
        "noSolidDestructuredProps": "off", // SolidJS
        "useQwikValidLexicalScope": "off" // Qwik
      },
      "performance": {
        "useSolidForComponent": "off", // SolidJS
        "noImgElement": "off", // Next.js
        "noJsxPropsBind": "off" // inline handlers are idiomatic React
      },
      "suspicious": { "noReactSpecificProps": "off" }, // SolidJS/Qwik
      "style": {
        "noTernary": "off", // idiomatic in JSX
        "noHexColors": "off",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "conventions": [
              {
                // API JSON field names come from Python (e.g. `updated_at`)
                "selector": { "kind": "typeProperty" },
                "formats": ["camelCase", "snake_case"]
              },
              {
                "selector": { "kind": "objectLiteralProperty" },
                "formats": ["camelCase", "snake_case"]
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.{ts,tsx}", "src/test/summaries.ts"],
      "linter": { "rules": { "style": { "noMagicNumbers": "off" } } } // expected values read best inline
    },
    {
      "includes": ["src/test/contrast.ts"],
      "linter": { "rules": { "style": { "noMagicNumbers": "off" } } } // colour-science constants
    },
    {
      "includes": [
        "vite.config.ts",
        "playwright.config.ts",
        "tools/api-client/openapi-ts.config.ts"
      ],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } } // the tools' config contract
    },
    {
      "includes": ["tools/**", "e2e/**", "playwright.config.ts"],
      "linter": { "rules": { "correctness": { "noNodejsModules": "off" } } } // build tools run in Node
    },
    {
      "includes": ["e2e/profile.ts", "playwright.config.ts"],
      "linter": { "rules": { "style": { "noProcessEnv": "off" } } } // the e2e port and CI come from it
    },
    {
      "includes": ["src/i18n/locales/**"],
      // the UI's texts: templates like "{{days}} at {{time}}" look random to the entropy check;
      // one file per language holds all of them, however many
      "linter": {
        "rules": {
          "security": { "noSecrets": "off" },
          "style": { "noExcessiveLinesPerFile": "off" }
        }
      }
    }
  ]
}
