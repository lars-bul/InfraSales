{
  "name": "infrasales-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit --project e2e",
    "e2e": "playwright test",
    "lint": "biome ci --error-on-warnings && pnpm --filter api-client run check",
    "format": "biome check --write",
    "test": "vitest run --coverage",
    "api-types": "pnpm --filter api-client run generate"
  },
  "packageManager": "pnpm@12.10.0+sha512.122a7b6ddf9d40268bc0db1a9780899b95e4fa8badfca7bd450615ad8cf7c2659f5f569c20ed7c53886bc7b08d0d50a54f4ad50706847f5682ec6c5048416539",
  "dependencies": {
