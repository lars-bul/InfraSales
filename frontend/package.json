    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "diff": "9.0.0",
    "i18next": "26.4.2",
    "lucide-react": "1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "shadcn": "4.21.4",
