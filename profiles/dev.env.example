# Development profile (`make dev`)to run the app locally, SQLite, sample users, mock LLM
# model. Copy to profiles/dev.env

# --- Database and logs ------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///data/infrasales.db
# DATABASE_POOL__SIZE=5              # PostgreSQL only
# DATABASE_POOL__OVERFLOW=5
# DATABASE_POOL__TIMEOUT_SECONDS=10
# DATABASE_APP_ROLE=                 # PostgreSQL only: roles `infrasales migrate` grants
# DATABASE_RETENTION_ROLE=
LOG_FORMAT=console
# LOG_LEVEL=INFO

# --- Web --------------------------------------------------------------------------------------
# WEB__HOST=127.0.0.1
# WEB__PORT=8000
# WEB__PUBLIC_URL=http://localhost:8000
WEB__FRONTEND_DIR=frontend/dist
WEB__API_DOCS=true                   # Swagger UI on /api/docs: development only (localhost)

# --- Sign-in: built-in, the sample users alice (admin) and vera (viewer) ----------------------
AUTH__PROVIDER=basic
AUTH__PASSWORD=dev-password
# AUTH__USERS={"lea": "admin", "tom": "viewer"}
# OpenID Connect instead (see profiles/prod.env.example):
# AUTH__ISSUER=
# AUTH__CLIENT_ID=
# AUTH__CLIENT_SECRET=
# AUTH__STATE_SECRET=
# AUTH__SCOPE=openid profile
# AUTH__GROUPS_CLAIM=groups
# AUTH__ADMIN_GROUPS=
# AUTH__VIEWER_GROUPS=

# --- Models (ADR 05): chosen on the Settings page; these seed only its first start ---------
# SECRETS_KEY=                         # secret: encrypts the stored API keys (`infrasales secrets-key`)
# OPENROUTER__API_KEY=                 # secret: chat and embeddings; a key with a credit limit
# LLM__PROVIDER=mock                 # the chat model's service: mock or openrouter
# LLM__MODEL=                        # as the service names it: GET <service>/v1/models
# EMBEDDING__PROVIDER=openrouter     # the embedding model's service
# EMBEDDING__MODEL=qwen/qwen3-embedding-8b
# EMBEDDING__TIMEOUT_SECONDS=30
# EMBEDDING__MAX_RETRIES=4          # on rate limits and server errors
# LLM__REPLY=Hello world             # what the mock answers
# LLM__MAX_WAIT_SECONDS=120          # for the chat model's rate limit; a longer wait fails the run
LLM__TRACE_CONTENT=true              # prompts and completions in traces: development data only

# --- Mail: unset, mails are logged instead of sent ---------------------------------------------
# SMTP__HOST=
# SMTP__PORT=587
# SMTP__SECURITY=starttls
# SMTP__USERNAME=
# SMTP__PASSWORD=
# SMTP__SENDER=
# SMTP__RECIPIENTS=
# SMTP__TIMEOUT_SECONDS=10

# --- Alerts on failing jobs: unset, they are only logged ---------------------------------------
# ALERTS__RECIPIENTS=                # needs SMTP__HOST
# ALERTS__WEBHOOK_URL=
# ALERTS__AFTER_FAILURES=2

# --- Telemetry: off until set; with Langfuse keys every job run becomes a trace ---------------
# OTEL_EXPORTER_OTLP_ENDPOINT=       # e.g. http://localhost:4318 (docker compose --profile otel)
# OTEL_SERVICE_NAME=infrasales
# OTEL_METRIC_EXPORT_INTERVAL=60000
# LANGFUSE_PUBLIC_KEY=pk-lf-…
# LANGFUSE_SECRET_KEY=sk-lf-…
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_RELEASE=                  # default: the app version

# --- Scheduler: when and how jobs run (defaults shown) --------------------------------------
# SCHEDULER__ENABLED=true            # false: `infrasales worker` runs the jobs instead of `infrasales web`
# SCHEDULER__POLL_SECONDS=30
# SCHEDULER__LEASE_SECONDS=60
# SCHEDULER__MAX_ATTEMPTS=3
# SCHEDULER__RETRY_SECONDS=60
# SCHEDULER__JOB_TIMEOUT_SECONDS=900
# SCHEDULER__SCRAPE_TIMEOUT_SECONDS=2700  # the scrape's own; 2/3 of it for requests

# --- Feeds and Source Versions --------------------------------------------------------------
# Where Source Versions are stored: an fsspec URI (file://…, later s3://… with s3fs).
SINK__URI=file://data/sink  # relative to where the app runs: data/ is gitignored

# --- Retention (defaults shown) ---------------------------------------------------------------
# `make dev` runs no retention: these are read only by a prune run by hand with this profile
# (`uv run --env-file profiles/dev.env infrasales prune`). The stack's are in compose.yaml.
# RETENTION__AUDIT_DAYS=180
# RETENTION__JOB_RUN_DAYS=90
# RETENTION__SOURCE_DAYS=     # unset: Source Versions are kept for good (ADR 06 §7)
