# Production profile: compose.prod.yaml (`make prod-up`), or a reference for your platform.
# Copy to profiles/prod.env

# --- Database: the app role's connection (migrate and retention get theirs from secrets/) ------
DATABASE_URL=postgresql+psycopg://infrasales_app:<password>@<host>/infrasales?sslmode=verify-full
# DATABASE_POOL__SIZE=5              # per process: budget replicas x (size + overflow)
# DATABASE_POOL__OVERFLOW=5
# DATABASE_POOL__TIMEOUT_SECONDS=10
DATABASE_APP_ROLE=infrasales_app
DATABASE_RETENTION_ROLE=infrasales_retention
LOG_FORMAT=json
# LOG_LEVEL=INFO

# --- Web --------------------------------------------------------------------------------------
# WEB__HOST=0.0.0.0                  # the image's default
# WEB__PORT=8000
WEB__PUBLIC_URL=https://infrasales.example.org   # exactly the URL browsers use
# WEB__FRONTEND_DIR=                 # the image's built UI
# WEB__API_DOCS=false               # Swagger UI on /api/docs: development only (localhost)

# --- Sign-in: OpenID Connect with the organization's identity provider -------------------------
AUTH__PROVIDER=oidc
# AUTH__ISSUER: exactly as the provider's `iss`
AUTH__ISSUER=
AUTH__CLIENT_ID=
# AUTH__CLIENT_SECRET: secret
AUTH__CLIENT_SECRET=
# AUTH__STATE_SECRET: secret: 32+ random characters
AUTH__STATE_SECRET=
# AUTH__SCOPE=openid profile
AUTH__GROUPS_CLAIM=groups
AUTH__ADMIN_GROUPS=
AUTH__VIEWER_GROUPS=
# AUTH__PASSWORD=                    # built-in sign-in only
# AUTH__USERS=

# --- Models (ADR 05): chosen on the Settings page; these seed only its first start ---------
SECRETS_KEY=                         # secret: encrypts the stored API keys (`infrasales secrets-key`)
OPENROUTER__API_KEY=                 # secret: chat and embeddings; a key with a credit limit
LLM__PROVIDER=openrouter          # the chat model's service: mock or openrouter
LLM__MODEL=                          # as the service names it: GET <service>/v1/models
# EMBEDDING__PROVIDER=openrouter     # the embedding model's service
# EMBEDDING__MODEL=qwen/qwen3-embedding-8b
# EMBEDDING__TIMEOUT_SECONDS=30
# EMBEDDING__MAX_RETRIES=4          # on rate limits and server errors
# LLM__REPLY=Hello world             # what the mock answers
# LLM__MAX_WAIT_SECONDS=120          # for the chat model's rate limit; a longer wait fails the run
LLM__TRACE_CONTENT=false             # true only where traces may hold prompts and completions

# --- Mail -------------------------------------------------------------------------------------
SMTP__HOST=
SMTP__PORT=587
# SMTP__SECURITY=starttls
SMTP__USERNAME=
# SMTP__PASSWORD: secret
SMTP__PASSWORD=
SMTP__SENDER=
SMTP__RECIPIENTS=
# SMTP__TIMEOUT_SECONDS=10

# --- Alerts on failing jobs -------------------------------------------------------------------
ALERTS__RECIPIENTS=
# ALERTS__WEBHOOK_URL=               # secret: its token is in the URL
# ALERTS__AFTER_FAILURES=2

# --- Telemetry: an OpenTelemetry collector, LLM traces in Langfuse; unset: off ----------------
# OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=infrasales
# OTEL_METRIC_EXPORT_INTERVAL=60000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=               # secret
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production
# LANGFUSE_RELEASE=                  # the deployment sets what it deploys, e.g. the git SHA

# --- Scheduler: when and how jobs run (defaults shown) --------------------------------------
# SCHEDULER__ENABLED=true            # false: `infrasales worker` runs the jobs instead of `infrasales web`
# SCHEDULER__POLL_SECONDS=30
# SCHEDULER__LEASE_SECONDS=60
# SCHEDULER__MAX_ATTEMPTS=3
# SCHEDULER__RETRY_SECONDS=60
# SCHEDULER__JOB_TIMEOUT_SECONDS=900
# SCHEDULER__SCRAPE_TIMEOUT_SECONDS=2700  # the scrape's own; 2/3 of it for requests

# --- Feeds and Source Versions --------------------------------------------------------------
# Where Source Versions are stored: an fsspec URI (file://…, later s3://… with s3fs).
# SINK__URI=file:///data/sink  # the named volume `sink` (compose.prod.yaml)

# --- Retention -------------------------------------------------------------------------------
# RETENTION__* are not read from this profile: the `retention` service does not load it (it holds
# the app's secrets). They are set in its `environment:` in compose.prod.yaml.
